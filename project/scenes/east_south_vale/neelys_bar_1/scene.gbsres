          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Press A to interact with the cart.",
                "\"Grab\" will let you pull or push\nthe cart everywhere based on\nyour direction.\nPress A/B/Start/Select to let\ngo off it.",
                "\"Climb on\" will let you climb on\nit instead.\nPress B/Start/Select to climb \ndown based on your direction.",
                "While interacting with the cart,\nyou can't attack, or open the \nmenu unless you let it go or climb\ndown."
              ],
