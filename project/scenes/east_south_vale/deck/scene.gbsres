              "speed": 1,
              "axis": [
                "x",
                "y"
              ]
            },
            "id": "49e15d70-6684-4869-8cc8-0555e66185ea"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "I got a letter.",
                "The name on the envelope\nsaid 'Mary'.",
                "My wife's name."
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
            },
            "id": "b43b660d-f6b7-4b61-b30e-8c3ab8e0ac3c"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "It's ridiculous. Couldn't\npossibly be true.",
                "That's what I keep telling\nmyself.",
                "Mary died of that damn\ndisease three years ago.",
                "So then why am I looking\nfor her?",
                "Our 'special place'...",
                "What could she mean?"
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
            },
            "id": "33119d40-03f0-47cc-abe5-f7846631d4a3"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "This whole town was our\nspecial place.",
                "Could Mary really be here?",
                "Is she really alive...?",
                "Waiting for me?"
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
