          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "In my restless dreams,\nI see that town.",
                "Silent Hill."
              ],
              "__section": "text",
              "avatarId": "a32b907e-5fb9-48f7-b8ce-63e3fa7086c9",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
            },
            "id": "4fb453d8-4e32-4eab-9292-8a7b5b6d7f8b"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "You promised you'd take\nme there again some day.",
                "But you never did."
              ],
              "__section": "text",
              "avatarId": "a32b907e-5fb9-48f7-b8ce-63e3fa7086c9",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
            },
            "id": "01e75462-417a-477b-a721-07500007debc"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Well, I'm alone there now.",
                "In our 'special place'.",
                "Waiting for you."
              ],
              "__section": "text",
              "avatarId": "a32b907e-5fb9-48f7-b8ce-63e3fa7086c9",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
            },
            "id": "099df408-f294-4688-ba90-b00e014872ae"
          },
          {
            "command": "EVENT_CAMERA_LOCK",
