          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "I got a letter.",
                "The name on the envelope\nsaid 'Mary'.",
                "My wife's name."
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
