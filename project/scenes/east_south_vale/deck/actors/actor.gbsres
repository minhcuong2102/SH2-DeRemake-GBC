            "id": "563f0576-ef74-4b4e-8a66-75d1e1ae3c92"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "It's ridiculous. Couldn't\npossibly be true.",
                "That's what I keep telling\nmyself.",
                "Mary died of that damn\ndisease three years ago.",
                "So then why am I looking\nfor her?",
                "Our 'special place'...",
                "What could she mean?"
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
              "minHeight": 4,
              "maxHeight": 7,
              "textX": 2,
              "textY": 1,
              "textHeight": 5,
              "position": "bottom",
              "clearPrevious": true,
              "showFrame": "true",
              "speedIn": -1,
              "speedOut": -1,
              "closeWhen": "key",
              "closeButton": "a",
              "closeDelayTime": 0.5,
              "closeDelayFrames": 30
