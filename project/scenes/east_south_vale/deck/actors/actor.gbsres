          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "You promised you'd take\nme there again some day.",
                "But you never did."
              ],
              "__section": "text",
              "avatarId": "a32b907e-5fb9-48f7-b8ce-63e3fa7086c9",
              "minHeight": 4,
