          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Well, I'm alone there now.",
                "In our 'special place'.",
                "Waiting for you."
              ],
              "__section": "text",
              "avatarId": "a32b907e-5fb9-48f7-b8ce-63e3fa7086c9",
              "minHeight": 4,
