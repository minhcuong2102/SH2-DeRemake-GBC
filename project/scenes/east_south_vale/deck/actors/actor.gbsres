            "id": "73f7967e-f5af-4aaa-8ff8-3b27da3ee7d4"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "This whole town was our\nspecial place.",
                "Could Mary really be here?",
                "Is she really alive...?",
                "Waiting for me?"
              ],
              "__section": "text",
              "avatarId": "c638579a-222e-444a-942e-d7194fec1120",
