                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "\"He came back after you left.\nIt's fine, he didn't try anything.\nHe just seemed sad.",
                            "\"Mumbled something about\ngetting out of town with someone.\nI wasn't gonna let him drive in\nhis condition, so I locked him out.",
                            "\"His car should be out back.\nMaybe check if it's still there by\nmorning. It's the greenish-blue\none, plate number ending with\n06, I think.\""
                          ],
