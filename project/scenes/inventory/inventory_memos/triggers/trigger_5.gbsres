                  },
                  "id": "dda91e75-474c-46db-87a7-319b03cd6a2c"
                }
              ],
              "true1": [
                {
                  "command": "EVENT_IF_FLAGS_COMPARE",
                  "args": {
                    "variable": "104",
                    "flag": 7,
                    "__collapseElse": true
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "I'm certain now, it's coming\nfrom that apartment upstairs.\nI keep telling them\nwhy won't they do something?",
                            "It's unbearable\nI can feel it seeping into\nmy skin",
                            "pushing itself into\nmy lungs"
                          ],
                          "__section": "text",
